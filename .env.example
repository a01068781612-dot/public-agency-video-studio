# ─────────────────────────────────────────────────────────────
# AI 유튜브 자동 발행 워크플로우 - 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (cp .env.example .env)
# GitHub Actions 로 자동화할 때는 저장소 Secrets 에 동일한 키로 등록하세요.
# ─────────────────────────────────────────────────────────────

# ── Anthropic (Claude) : 대본/구성 생성 ──
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 사용할 모델 (기본: claude-opus-4-8)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── ElevenLabs : 나레이션(TTS) ──
# https://elevenlabs.io/app/settings/api-keys 에서 발급
# ── 나레이션 provider ── gemini(기본, 한국어 원어민) | elevenlabs
TTS_PROVIDER=gemini
# preview 모델이라 ID 가 바뀔 수 있다
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# 음성 30종 중 하나. 시청은 .github/workflows/voice-check.yml 로.
GEMINI_TTS_VOICE=Sulafat
# 그 음성의 실측 발화 속도(초당 글자) — 60초 상한 환산 기준
TTS_CHARS_PER_SEC=6.6

ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# 한국어에 잘 맞는 목소리 ID (Voice Library 에서 복사). 기본값은 다국어 예시 voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# TTS 모델 (한국어는 다국어 모델 권장)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── YouTube Data API v3 (GCP) : 업로드 ──
# GCP 콘솔에서 OAuth 클라이언트(데스크톱 앱) 생성 후 값 입력
# 자세한 절차는 README 참고. refresh token 은 `npm run authorize:youtube` 로 발급.
YOUTUBE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx
# 업로드 공개 상태: public | unlisted | private
YOUTUBE_PRIVACY_STATUS=private
# 업로드 후 category (기본 27 = Education)
YOUTUBE_CATEGORY_ID=27

# ── 콘텐츠 설정 ──
# 영상 주제 모드: trend(최신 AI 트렌드) | basics(AI 기초 상식) | auto(요일별 자동)
CONTENT_MODE=auto
# 대상 영상 길이(분). 대본 분량 가이드로 사용됩니다.
TARGET_MINUTES=10
# 영상/자막 언어
CONTENT_LANGUAGE=ko
# 홍보 타겟 기관(선택, src/lib/agency.ts 의 id). 비우면 특정 기관 없이 일반 공공부문 관점.
# 예: moe(교육부), molit(국토교통부), police(경찰청) 등. 전체 목록은 agency.ts 참고.
AGENCY=

# ── 파이프라인 동작 ──
# true 이면 실제 업로드까지 진행, false 이면 렌더까지만 (out/ 에 mp4 저장)
DO_UPLOAD=false

# ── 비용 안전장치 ──
# false 로 두면 유료 API(대본·나레이션·이미지)를 호출하는 단계를 아예 실행하지 않는다. 비상정지용.
SPEND_ENABLED=true
# 실행 1회에 만들 AI 이미지 최대 장수. 대본이 만든 그림 씬이 이보다 많으면 초과분은 글자 화면으로 렌더된다.
MAX_IMAGES_PER_RUN=6

# ── 썸네일 (gpt-image-1) : 선택 ──
# OpenAI 이미지 생성으로 인물 합성 + 한글 제목 썸네일 자동 생성. 없으면 기본 손그림 썸네일 사용.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 이미지 모델명 (기본 gpt-image-1). 새 모델 나오면 여기만 바꾸면 됨.
OPENAI_IMAGE_MODEL=gpt-image-1
# 진행자 사진: 저장소에 커밋하기 싫으면 이미지 URL 을 넣으세요(비우면 assets/presenter.png 사용).
PRESENTER_IMAGE_URL=
# 썸네일 배경 톤: dark(칠판) | cream(종이)
THUMBNAIL_TONE=dark

# 화면 비율: 16:9(가로, 기본) | 9:16(세로 쇼츠). 렌더 해상도와 AI 이미지 생성 비율이 함께 바뀐다.
ASPECT_RATIO=16:9

# ── 실사 클립: 시댄스(Seedance) 2.5, Replicate 경유 (필수 구성) ──
# 분위기·배경용 짧은 실사 영상 클립을 생성해 끼워 넣는다. 영상 1편 비용의 큰 몫을 차지하므로
# 비용을 줄이려면 끄는 대신 LIVE_VIDEO_CLIP_COUNT 를 줄이는 편이 낫다(테스트 때만 false).
USE_LIVE_VIDEO=true
# https://replicate.com/account/api-tokens 에서 발급.
REPLICATE_API_TOKEN=
SEEDANCE_MODEL=bytedance/seedance-2.5
# 480p 가 최저 해상도이자 최저가(720p 대비 절반 이하). 화질이 필요하면 720p.
SEEDANCE_RESOLUTION=480p
# 클립 개수(하드 상한).
LIVE_VIDEO_CLIP_COUNT=6
# 클립 길이(초). 시댄스 2.5는 4~30초 사이 정수를 받는다(Veo처럼 4·6·8 고정 단계가 아니다).
LIVE_VIDEO_CLIP_SECONDS=4
